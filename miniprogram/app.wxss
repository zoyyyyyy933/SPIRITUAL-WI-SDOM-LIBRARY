/* 全局颜色变量 */
page {
  --bg-primary: #1A1A2E;
  --bg-card: #16213E;
  --bg-elevated: #0F3460;
  --accent-gold: #C8A96E;
  --accent-purple: #7B5EA7;
  --text-primary: #F0EAD6;
  --text-secondary: #A8A4B8;
  --text-muted: #6B6780;
  --rarity-normal: #8A9BA8;
  --rarity-rare: #7B5EA7;
  --rarity-hidden: #C8A96E;
  --danger: #E05C5C;
  --success: #5CB85C;

  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
}

/* 通用卡片 */
.card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

/* 通用按钮 */
.btn-primary {
  background: linear-gradient(135deg, var(--accent-gold), #A07840);
  color: #1A1A2E;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-weight: 700;
  font-size: 30rpx;
  text-align: center;
  border: none;
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.btn-secondary {
  background: transparent;
  color: var(--accent-gold);
  border: 2rpx solid var(--accent-gold);
  border-radius: 48rpx;
  padding: 22rpx 48rpx;
  font-size: 28rpx;
  text-align: center;
  display: block;
  width: 100%;
  box-sizing: border-box;
}

/* 稀有度标签 */
.badge {
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-normal { background: rgba(138,155,168,0.2); color: var(--rarity-normal); }
.badge-rare   { background: rgba(123,94,167,0.2);  color: var(--rarity-rare); }
.badge-hidden { background: rgba(200,169,110,0.2); color: var(--rarity-hidden); }

/* 分割线 */
.divider {
  height: 1rpx;
  background: rgba(255,255,255,0.08);
  margin: 24rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  color: var(--text-muted);
}

.empty-state text {
  font-size: 26rpx;
  margin-top: 24rpx;
  text-align: center;
  line-height: 1.6;
}
