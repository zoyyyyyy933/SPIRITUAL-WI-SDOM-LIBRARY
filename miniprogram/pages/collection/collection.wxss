.container {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-primary);
}

/* 统计行 */
.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--accent-gold);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 晒单按钮 */
.poster-btn {
  margin-bottom: 40rpx;
}

/* 分区标题 */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 16rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

/* 系列行 */
.series-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.row-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.row-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.brand-tag-sm {
  display: inline-block;
  background: rgba(123,94,167,0.2);
  color: var(--accent-purple);
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  width: fit-content;
}

.row-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.hidden-badge {
  font-size: 22rpx;
  color: var(--accent-gold);
}

.row-count {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent-gold);
  white-space: nowrap;
  padding-left: 16rpx;
}

.progress-bar-bg {
  height: 10rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent-purple), var(--accent-gold));
  border-radius: 8rpx;
  transition: width 0.4s ease;
}

.row-pct {
  font-size: 22rpx;
  color: var(--text-muted);
  text-align: right;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 120rpx 48rpx 48rpx;
  color: var(--text-muted);
  font-size: 28rpx;
  text-align: center;
  line-height: 1.6;
}

.go-btn {
  margin-top: 24rpx;
}

.loading {
  text-align: center;
  color: var(--text-muted);
  padding: 80rpx 0;
  font-size: 26rpx;
}
