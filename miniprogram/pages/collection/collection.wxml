<view class="container">
  <!-- 统计卡片 -->
  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-value">{{totalOwned}}</text>
      <text class="stat-label">总入库</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{summaryList.length}}</text>
      <text class="stat-label">参与系列</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">¥{{totalSpent}}</text>
      <text class="stat-label">累计花费</text>
    </view>
  </view>

  <!-- 晒单按钮 -->
  <view class="btn-primary poster-btn" bindtap="onMakePoster" wx:if="{{totalOwned > 0}}">
    ✨ 生成晒单海报
  </view>

  <!-- 系列进度列表 -->
  <view wx:if="{{summaryList.length > 0}}">
    <text class="section-title">我的系列</text>
    <view
      wx:for="{{summaryList}}"
      wx:key="id"
      class="series-row card"
      data-id="{{item.id}}"
      bindtap="onSeriesTap"
    >
      <view class="row-top">
        <view class="row-left">
          <view class="brand-tag-sm">{{item.brand}}</view>
          <text class="row-name">{{item.name}}</text>
          <view class="hidden-badge" wx:if="{{item.hasHidden}}">✨ 已收隐藏款</view>
        </view>
        <text class="row-count">{{item.ownedCount}}/{{item.totalCount}}</text>
      </view>
      <view class="progress-bar-bg">
        <view class="progress-bar-fill" style="width: {{item.pct}}%"></view>
      </view>
      <text class="row-pct">{{item.pct}}% 完成</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{summaryList.length === 0 && !loading}}">
    <text>📦</text>
    <text>还没有入库任何款式\n去发现页面开始收藏吧～</text>
    <view class="btn-primary go-btn" bindtap="onGoDiscovery">去发现系列</view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
