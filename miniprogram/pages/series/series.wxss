.container {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-primary);
}

/* 顶部 header */
.series-header {
  margin-bottom: 32rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.brand-tag {
  background: rgba(123,94,167,0.2);
  color: var(--accent-purple);
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.series-year {
  color: var(--text-muted);
  font-size: 24rpx;
}

.series-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 32rpx;
}

/* 进度条 */
.progress-wrap { }

.progress-labels {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.progress-label {
  color: var(--text-secondary);
  font-size: 26rpx;
}

.progress-count {
  color: var(--accent-gold);
  font-size: 26rpx;
  font-weight: 600;
}

.progress-bar-bg {
  height: 12rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent-purple), var(--accent-gold));
  border-radius: 8rpx;
  transition: width 0.4s ease;
}

/* 款式网格 */
.figures-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.figure-item {
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  border: 2rpx solid transparent;
  position: relative;
  transition: all 0.2s;
}

.figure-item.owned {
  border-color: var(--accent-gold);
  background: rgba(200,169,110,0.08);
}

.owned-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 36rpx;
  height: 36rpx;
  background: var(--accent-gold);
  color: #1A1A2E;
  border-radius: 50%;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.figure-img {
  width: 100rpx;
  height: 100rpx;
  background: var(--bg-elevated);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.figure-emoji {
  font-size: 48rpx;
}

.figure-name {
  font-size: 22rpx;
  color: var(--text-primary);
  text-align: center;
  line-height: 1.4;
  word-break: break-all;
}

.figure-rate {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 弹窗 */
.dialog-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.dialog {
  background: var(--bg-card);
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.dialog-sub {
  font-size: 26rpx;
  color: var(--text-muted);
}

.dialog-input {
  width: 100%;
  background: var(--bg-elevated);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  color: var(--text-primary);
  font-size: 32rpx;
  box-sizing: border-box;
  margin-top: 8rpx;
}

.dialog-unit {
  color: var(--text-secondary);
  font-size: 26rpx;
  align-self: flex-end;
  margin-top: -8rpx;
}

.dialog-btns {
  display: flex;
  gap: 24rpx;
  width: 100%;
  margin-top: 16rpx;
}

.dialog-btn {
  flex: 1;
}
