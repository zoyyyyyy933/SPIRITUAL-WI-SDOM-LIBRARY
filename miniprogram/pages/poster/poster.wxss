.container {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-primary);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.page-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 16rpx;
  display: block;
}

.page-sub {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
  margin-bottom: 40rpx;
  display: block;
}

.canvas-wrap {
  width: 375rpx;
  height: 500rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.5);
  margin-bottom: 48rpx;
}

.poster-canvas {
  width: 375px;
  height: 500px;
}

.actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.save-btn {
  margin-top: 0;
}

.disabled {
  opacity: 0.5;
}

.tip {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 32rpx;
  text-align: center;
}
