.container {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-primary);
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 48rpx;
  padding: 20rpx 32rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  color: var(--text-primary);
  font-size: 28rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-left: 16rpx;
}

/* 品牌筛选 */
.brand-filter {
  white-space: nowrap;
  margin-bottom: 32rpx;
}

.brand-tag {
  display: inline-block;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  border: 2rpx solid var(--text-muted);
  color: var(--text-secondary);
  font-size: 26rpx;
  margin-right: 16rpx;
  transition: all 0.2s;
}

.brand-tag.active {
  border-color: var(--accent-gold);
  color: var(--accent-gold);
  background: rgba(200, 169, 110, 0.1);
}

/* 系列卡片网格 */
.series-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.series-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 24rpx;
  gap: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
}

.series-img-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: var(--bg-elevated);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.series-emoji {
  font-size: 60rpx;
}

.series-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.series-brand-tag {
  display: inline-block;
  background: rgba(123, 94, 167, 0.2);
  color: var(--accent-purple);
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  width: fit-content;
}

.series-name {
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.series-meta {
  color: var(--text-muted);
  font-size: 24rpx;
}
